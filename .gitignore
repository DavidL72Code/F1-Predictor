# Environment files. .env.example is the tracked template; everything else is
# local and may hold credentials (ALLOWED_ORIGINS, RENDER_API_URL, keys).
.env
.env.*
!.env.example

# Python virtual environments
venv/

# macOS metadata
.DS_Store

# Python caches
__pycache__/
*.pyc

# Notebook autosaves
.ipynb_checkpoints/

# Editor workspace files
*.code-workspace

# Local agent/editor tooling config
.claude/

# Frontend build artifacts
frontend/node_modules/
frontend/build/
.vercel/

# FastF1 caches. Regenerable, and huge — the copy under fastf1_cache/ was being
# rewritten and committed on every scheduled run (~31MB of fresh binary each
# time, 34 commits' worth) because the pattern below is anchored to data/raw and
# missed the nested path.
data/raw/fastf1_cache/
data/raw/**/fastf1_http_cache.sqlite
data/raw/fastf1_http_cache.sqlite
data/raw/**/*.ff1pkl

# Large local experiment artifact
data/processed/feature_search_all_methods.json
