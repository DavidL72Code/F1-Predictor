# Environment files. .env.example is the tracked template; everything else is
# local and may hold credentials (ALLOWED_ORIGINS, RENDER_API_URL, keys).
.env
.env.*
!.env.example

# Python virtual environments
venv/

# macOS metadata
.DS_Store

# Python caches
__pycache__/
*.pyc

# Notebook autosaves
.ipynb_checkpoints/

# Editor workspace files
*.code-workspace

# Local agent/editor tooling config
.claude/

# Frontend build artifacts
frontend/node_modules/
frontend/build/
.vercel/

# Local FastF1 cache
data/raw/fastf1_http_cache.sqlite
data/raw/**/*.ff1pkl

# Large local experiment artifact
data/processed/feature_search_all_methods.json
